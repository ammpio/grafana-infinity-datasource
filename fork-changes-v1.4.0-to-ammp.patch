diff --git a/website/src/components/SubHeader.tsx b/website/src/components/SubHeader.tsx
new file mode 100644
index 00000000..ebc2860c
--- /dev/null
+++ b/website/src/components/SubHeader.tsx
@@ -0,0 +1,26 @@
+import React from 'react';
+import { useStaticQuery, graphql } from 'gatsby';
+
+interface SubHeaderProps {
+  title: string;
+  children?: React.ReactNode;
+}
+
+export const SubHeader = (props: SubHeaderProps) => {
+  const data = useStaticQuery(
+    graphql`
+      query {
+        site {
+          siteMetadata {
+            wallpaper
+          }
+        }
+      }
+    `
+  );
+  return (
+    <section id="subheader" className="subheader py-5 text-center">
+      <h1>{props.title}</h1>
+    </section>
+  );
+};
